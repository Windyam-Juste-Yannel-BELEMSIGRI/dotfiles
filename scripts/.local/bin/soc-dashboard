#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────╮
# │ soc-dashboard — poste de veille SOC dans tmux (session "soc")        │
# │ Usage : soc-dashboard [commande] [-h]                                │
# │   (aucune)  crée/rejoint la session tmux "soc" (4 panneaux) :        │
# │     ┌─────────────────────────┬──────────────────────┐               │
# │     │ auth   journal sécurité │ alerts  synthèse 24 h│               │
# │     │ (sshd, sudo, su, polkit,├──────────────────────┤               │
# │     │  login) en direct       │ ports   écoute+conns │               │
# │     ├─────────────────────────┴──────────────────────┤               │
# │     │ procs  processus (btop si présent, sinon top)  │               │
# │     └────────────────────────────────────────────────┘               │
# │   auth | alerts | ports   lance un seul panneau (utilisé par tmux)   │
# │   kill                    ferme la session                           │
# │ Extension : chaque script exécutable de ~/.config/soc/hooks.d/ est   │
# │ appelé par le panneau "alerts" ; sa sortie y est affichée. Exemple   │
# │ fourni : ssh-sentinel.sh.example (requête PostgreSQL ssh-sentinel).  │
# │ Droits : lire le journal système demande le groupe systemd-journal.  │
# ╰──────────────────────────────────────────────────────────────────────╯
set -euo pipefail
# shellcheck source=../lib/soc/ui.sh
source "$(dirname "$(readlink -f "$0")")/../lib/soc/ui.sh"
usage() { sed -n '3,19p' "$0" | sed 's/^# │ \{0,1\}//; s/ *│$//'; }

SELF=$(readlink -f "$0")
SESSION=soc
HOOKS=${XDG_CONFIG_HOME:-$HOME/.config}/soc/hooks.d
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/soc
mkdir -p "$STATE"

# Identifiants syslog des événements d'authentification suivis
AUTH_IDS=(-t sshd -t sshd-session -t sudo -t su -t login -t polkitd -t systemd-logind -t gdm-password -t unix_chkpwd)

# indent : préfixe chaque ligne de stdin de 4 espaces
indent() { local l; while IFS= read -r l; do printf '    %s\n' "$l"; done; }

journal_ok() { journalctl -q -n0 --system >/dev/null 2>&1 && [[ $(journalctl -q -n1 --system 2>/dev/null | wc -l) -gt 0 ]]; }

# ── Panneau : flux d'authentification ──────────────────────────────────
pane_auth() {
  box_title "AUTH // flux sécurité en direct" "sshd · sudo · su · login · polkit · logind"
  if ! journal_ok; then
    warn "journal système illisible : ajoutez-vous au groupe systemd-journal"
    warn "  sudo usermod -aG systemd-journal $USER   (puis reconnexion)"
  fi
  if [[ -r /var/log/auth.log ]]; then
    info "source : /var/log/auth.log"
    tail -n 30 -F /var/log/auth.log
  else
    info "source : journald (pas de rsyslog → pas d'auth.log sur Debian 13)"
    journalctl -f -n 40 -o short-iso --no-hostname "${AUTH_IDS[@]}" \
      | awk -v r="$C_RED" -v y="$C_YEL" -v g="$C_GRN" -v z="$C_RST" '
          /Failed|failure|Invalid|BREAK-IN|incorrect|not in sudoers|DENIED/ {print r $0 z; fflush(); next}
          /Accepted|session opened|COMMAND=/ {print y $0 z; fflush(); next}
          {print; fflush()}'
  fi
}

# ── Panneau : synthèse / alertes (rafraîchie toutes les 30 s) ──────────
alerts_once() {
  local since=${1:--24h} fails top sudo_fail new_ports base cur
  printf '\e[H\e[2J'
  box_title "ALERTS // synthèse $since" "$(date '+%F %T') · UTC $(date -u +%H:%M)"

  section "SSH"
  if systemctl -q is-active ssh 2>/dev/null; then
    fails=$(journalctl -q --since "$since" -t sshd -t sshd-session 2>/dev/null | grep -cE 'Failed password|Invalid user' || true)
    printf '  échecs : %s%s%s\n' "$(color_for $(( fails > 100 ? 100 : fails )) 1 50)" "$fails" "$C_RST"
    top=$(journalctl -q --since "$since" -t sshd -t sshd-session 2>/dev/null \
          | grep -oE 'from ([0-9]{1,3}\.){3}[0-9]{1,3}|from [0-9a-f:]+:[0-9a-f:]+' | awk '{print $2}' \
          | sort | uniq -c | sort -rn | head -5)
    [[ -n $top ]] && { echo "  top sources :"; indent <<<"$top"; }
  else
    printf '  %sserveur SSH inactif / non installé%s %s\n' "$C_GRN" "$C_RST" "(surface d'attaque réduite)"
  fi

  section "SUDO / SU"
  sudo_fail=$(journalctl -q --since "$since" -t sudo -t su 2>/dev/null | grep -ciE 'incorrect password|authentication failure|not in sudoers' || true)
  printf '  %s : %s\n' "échecs d'élévation" "$sudo_fail"
  printf '  commandes sudo     : %s\n' "$(journalctl -q --since "$since" -t sudo 2>/dev/null | grep -c 'COMMAND=' || true)"

  section "PORTS EN ÉCOUTE (écart avec la référence)"
  base=$STATE/listen.baseline
  cur=$(ss -Htuln | awk '{print $1, $5}' | sort -u)
  [[ -f $base ]] || { echo "$cur" > "$base"; info "référence créée : $base"; }
  new_ports=$(comm -13 "$base" <(echo "$cur") || true)
  if [[ -n $new_ports ]]; then
    printf '  %s⚠ nouveaux ports depuis la référence :%s\n' "$C_RED" "$C_RST"; indent <<<"$new_ports"
    printf '  %s(accepter : rm %s)%s\n' "$C_MUTED" "$base" "$C_RST"
  else
    ok "aucun nouveau port ($(wc -l <<<"$cur") en écoute)"
  fi

  section "SYSTÈME"
  printf '  unités en échec : %s\n' "$(systemctl --failed --no-legend 2>/dev/null | wc -l)"
  printf '  erreurs noyau   : %s (prio ≤ err, %s)\n' "$(journalctl -q -k -p err --since "$since" 2>/dev/null | wc -l)" "$since"

  if compgen -G "$HOOKS/*" >/dev/null; then
    section "HOOKS ($HOOKS)"
    local h
    for h in "$HOOKS"/*; do
      [[ -x $h && -f $h ]] || continue
      printf '  %s▸ %s%s\n' "$C_ACC" "${h##*/}" "$C_RST"
      timeout 20 "$h" 2>&1 | sed 's/^/    /' || warn "hook ${h##*/} en erreur"
    done
  fi
}
pane_alerts() { while :; do alerts_once "-24h"; sleep 30; done; }

# ── Panneau : ports et connexions ──────────────────────────────────────
pane_ports() {
  while :; do
    printf '\e[H\e[2J'
    box_title "PORTS // écoute & connexions" "$(date '+%T')"
    section "ÉCOUTE"
    ss -Htulnp 2>/dev/null | awk '{p=$7; sub(/.*\(\("/,"",p); sub(/".*/,"",p); printf "  %-4s %-26s %s\n", $1, $5, (p==""?"-":p)}' | sort -u
    section "ÉTABLIES ($(ss -Htn state established | wc -l))"
    ss -Htnp state established 2>/dev/null | awk '{p=$5; sub(/.*\(\("/,"",p); sub(/".*/,"",p); printf "  %-26s %s\n", $4, (p==""?"-":p)}' | head -12
    sleep 5
  done
}

session() {
  need tmux journalctl ss
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
  fi
  local procs="top"; command -v btop >/dev/null && procs="btop"
  tmux new-session -d -s "$SESSION" -n soc -x "$(tput cols 2>/dev/null || echo 200)" -y "$(tput lines 2>/dev/null || echo 50)" "$SELF auth"
  tmux split-window -t "$SESSION:soc" -v -l 35% "$procs"
  tmux select-pane -t "$SESSION:soc.0"
  tmux split-window -t "$SESSION:soc.0" -h -l 45% "$SELF alerts"
  tmux split-window -t "$SESSION:soc.1" -v -l 45% "$SELF ports"
  tmux select-pane -t "$SESSION:soc.0" -T auth
  tmux select-pane -t "$SESSION:soc.1" -T alerts
  tmux select-pane -t "$SESSION:soc.2" -T ports
  tmux select-pane -t "$SESSION:soc.3" -T procs
  tmux select-pane -t "$SESSION:soc.0"
  exec tmux attach -t "$SESSION"
}

case ${1:-} in
  -h|--help) usage ;;
  "") session ;;
  auth) pane_auth ;;
  alerts) pane_alerts ;;
  alerts-once) alerts_once "${2:--24h}" ;;
  ports) pane_ports ;;
  kill) tmux kill-session -t "$SESSION" ;;
  *) usage >&2; exit 1 ;;
esac
