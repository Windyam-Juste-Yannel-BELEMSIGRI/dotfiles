#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────╮
# │ power-menu — menu d'alimentation fuzzel (remplace wlogout)           │
# │ Usage : power-menu [-h]                                              │
# │ Verrouiller · Déconnexion · Veille · Redémarrer · Éteindre           │
# │ (Redémarrer / Éteindre / Déconnexion demandent confirmation.)        │
# │ Hibernation non proposée : elle exigerait resume= dans GRUB.         │
# ╰──────────────────────────────────────────────────────────────────────╯
set -euo pipefail
# shellcheck source=../lib/soc/ui.sh
source "$(dirname "$(readlink -f "$0")")/../lib/soc/ui.sh"
[[ ${1:-} == -h || ${1:-} == --help ]] && { sed -n '3,6p' "$0" | sed 's/^# │ \{0,1\}//; s/ *│$//'; exit 0; }
need fuzzel systemctl swaymsg

# confirm ACTION : demande oui/non dans fuzzel ; vrai si "oui"
confirm() {
  [[ $(printf '󰄬  Oui, %s\n󰜺  Annuler\n' "$1" | menu "$1 ?" --lines 2 --width 30) == *Oui* ]]
}

up=$(awk '{printf "%dh%02d", $1/3600, ($1%3600)/60}' /proc/uptime)
choice=$(printf '%s\n' \
  "󰌾  Verrouiller" \
  "󰍃  Déconnexion (quitter Sway)" \
  "󰤄  Veille" \
  "󰜉  Redémarrer" \
  "󰐥  Éteindre" | menu "⏻ up $up" --lines 5 --width 34) || exit 0

case $choice in
  *Verrouiller*) exec "$HOME/.local/bin/lock-glitch" ;;
  *Déconnexion*) confirm "quitter Sway" && swaymsg exit ;;
  *Veille*)      systemctl suspend ;;
  *Redémarrer*)  confirm "redémarrer" && systemctl reboot ;;
  *Éteindre*)    confirm "éteindre" && systemctl poweroff ;;
esac
