#!/usr/bin/env python3
# ╭──────────────────────────────────────────────────────────────────────╮
# │ wallgen — génère le fond « SOC Matrix » (celui de windows-geek-theme)│
# │ Dégradé sombre, halo vert en bas à droite, grille, coins ambre,      │
# │ ligne d'état. Aucune image téléchargée : tout est dessiné (Cairo).   │
# │ Usage : wallgen FICHIER.png [--size LxH] [--network] [--prompt TXT]  │
# │                 [--accent RRGGBB] [--status TXT]                     │
# │   --network  ajoute une image fixe du graphe réseau animé (pour ce   │
# │              qui ne peut pas être animé : écran de verrouillage)     │
# │   --prompt   ajoute « $ whoami » / « > TXT » en bas à droite         │
# │ Dépendance : python3-cairo (déjà requis par livebg et agenda-gui).   │
# ╰──────────────────────────────────────────────────────────────────────╯
import argparse, math, random, sys

FONT = 'JetBrainsMono Nerd Font'


def rgb(h):
    h = h.lstrip('#')
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def generate(path, W, H, accent='00ff9c', network=False, prompt='', status='SOC // ONLINE   data-pipeline: nominal'):
    import cairo
    u = H / 1600.0                      # toutes les tailles sont définies pour 1600 px de haut
    ar, ag, ab = rgb(accent)
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
    cr = cairo.Context(surf)

    # fond : dégradé diagonal #0d1319 → #05080b
    g = cairo.LinearGradient(0, 0, W, H)
    g.add_color_stop_rgb(0, *rgb('0d1319')); g.add_color_stop_rgb(1, *rgb('05080b'))
    cr.set_source(g); cr.paint()

    # halo d'accent, en bas à droite
    cx, cy, rx, ry = W * 0.825, H * 0.775, W * 0.375, H * 0.475
    cr.save(); cr.translate(cx, cy); cr.scale(rx, ry)
    halo = cairo.RadialGradient(0, 0, 0, 0, 0, 1)
    halo.add_color_stop_rgba(0, ar, ag, ab, 34 / 255); halo.add_color_stop_rgba(1, ar, ag, ab, 0)
    cr.set_source(halo); cr.arc(0, 0, 1, 0, 2 * math.pi); cr.fill(); cr.restore()

    # grille : un trait fin tous les 40 px, un trait marqué toutes les 5 cases
    step = max(8, int(40 * u))
    for major in (False, True):
        cr.set_source_rgba(ar, ag, ab, (30 if major else 14) / 255)
        cr.set_line_width(max(1, 2 * u) if major else 1)
        for i, x in enumerate(range(0, W + 1, step)):
            if (i % 5 == 0) == major: cr.move_to(x + .5, 0); cr.line_to(x + .5, H)
        for i, y in enumerate(range(0, H + 1, step)):
            if (i % 5 == 0) == major: cr.move_to(0, y + .5); cr.line_to(W, y + .5)
        cr.stroke()

    # graphe réseau figé : mêmes règles que l'animation livebg (liens sous une distance, quelques paquets)
    if network:
        rnd = random.Random(1337)       # graine fixe : image reproductible
        s = u * 1.4
        count = int(min(120, W * H / (16000 * s * s) * 1.6))
        link = 150.0 * s
        pts = [(rnd.random() * W, rnd.random() * H, (rnd.random() * 1.6 + 0.8) * s) for _ in range(count)]
        node = rgb('7d8898')
        packets = []
        cr.set_line_width(max(1, 0.9 * s))
        for a in range(count):
            for b in range(a + 1, count):
                dx, dy = pts[a][0] - pts[b][0], pts[a][1] - pts[b][1]
                d = math.hypot(dx, dy)
                if d >= link: continue
                cr.set_source_rgba(*node, (1 - d / link) * 150 / 255)
                cr.move_to(pts[a][0], pts[a][1]); cr.line_to(pts[b][0], pts[b][1]); cr.stroke()
                if rnd.random() < 0.12:
                    t = rnd.random(); packets.append((pts[a][0] - dx * t, pts[a][1] - dy * t))
        cr.set_source_rgba(*rgb('00e5ff'), 0.9)
        for x, y in packets: cr.arc(x, y, 2.2 * s, 0, 2 * math.pi); cr.fill()
        for n, (x, y, r) in enumerate(pts):
            if n % 17 == 0: cr.set_source_rgba(ar, ag, ab, 1); r += s
            else: cr.set_source_rgba(*node, 190 / 255)
            cr.arc(x, y, r, 0, 2 * math.pi); cr.fill()

    # coins ambre façon viseur, bien à l'intérieur des bords
    m, l = int(70 * u), int(90 * u)
    cr.set_source_rgba(*rgb('ffb000'), 170 / 255); cr.set_line_width(max(2, 3 * u))
    for x, y, sx, sy in ((m, m, 1, 1), (W - m, m, -1, 1), (m, H - m, 1, -1), (W - m, H - m, -1, -1)):
        cr.move_to(x + sx * l, y); cr.line_to(x, y); cr.line_to(x, y + sy * l)
    cr.stroke()

    # ligne d'état discrète, en bas à gauche
    cr.select_font_face(FONT, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    if status:
        cr.set_font_size(20 * u); cr.set_source_rgba(ar, ag, ab, 110 / 255)
        cr.move_to(m + 16 * u, H - m - 22 * u); cr.show_text(status)

    # invite de terminal, alignée à droite dans le coin inférieur droit
    if prompt:
        cr.set_font_size(23 * u)
        for text, color, dy in (('$ whoami', (ar, ag, ab, 210 / 255), 66 * u), ('> ' + prompt, (*rgb('c5d1de'), 200 / 255), 26 * u)):
            ext = cr.text_extents(text)
            cr.set_source_rgba(*color); cr.move_to(W - m - 20 * u - ext.x_advance, H - m - dy); cr.show_text(text)

    surf.write_to_png(path)


if __name__ == '__main__':
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument('out', nargs='?'); ap.add_argument('--size', default='2560x1600')
    ap.add_argument('--network', action='store_true'); ap.add_argument('--prompt', default='')
    ap.add_argument('--accent', default='00ff9c'); ap.add_argument('--status', default='SOC // ONLINE   data-pipeline: nominal')
    ap.add_argument('-h', '--help', action='store_true')
    a = ap.parse_args()
    if a.help or not a.out:
        for line in open(__file__, encoding='utf-8').read().split('\n')[2:11]: print(line.strip('# │').rstrip('│ ').rstrip())
        sys.exit(0 if a.help else 1)
    try: w, h = (int(v) for v in a.size.lower().split('x'))
    except ValueError: sys.exit('wallgen : --size attend LxH (ex. 2560x1600)')
    generate(a.out, w, h, a.accent, a.network, a.prompt, a.status)
