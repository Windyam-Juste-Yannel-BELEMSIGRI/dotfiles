#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────╮
# │ set-wallpaper — fonds d'écran "glass // SOC"                         │
# │ Usage : set-wallpaper [apply|next|gen|list|FICHIER] [-h]             │
# │   apply  (défaut) applique ~/.local/share/backgrounds/current         │
# │          (le crée si absent : image perso, sinon fond généré)         │
# │   next   passe à l'image suivante                                     │
# │   gen    (re)génère le fond « SOC Matrix » (wallgen) à la résolution  │
# │          de l'écran principal                                         │
# │   list   liste les images disponibles                                 │
# │ Images perso : déposez-les dans ~/Pictures/wallpaper/ (prioritaires,  │
# │ ex. mahoraga.png du thème d'origine). Aucune image téléchargée.       │
# ╰──────────────────────────────────────────────────────────────────────╯
set -euo pipefail
# shellcheck source=../lib/soc/ui.sh
source "$(dirname "$(readlink -f "$0")")/../lib/soc/ui.sh"
usage() { sed -n '3,12p' "$0" | sed 's/^# │ \{0,1\}//; s/ *│$//'; }

BG_DIR=$HOME/.local/share/backgrounds
USER_DIR=$HOME/Pictures/wallpaper
CUR=$BG_DIR/current
GEN=$BG_DIR/glass-soc.png
mkdir -p "$BG_DIR"

# images : liste triée des fonds disponibles (perso d'abord, puis générés)
images() {
  find "$USER_DIR" "$BG_DIR" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    ! -name 'lock-*' 2>/dev/null | sort
}

# screen_size : "LxH" de la sortie focalisée (2560x1600 par défaut)
screen_size() {
  swaymsg -t get_outputs -r 2>/dev/null \
    | jq -r 'first(.[] | select(.focused)) | "\(.current_mode.width)x\(.current_mode.height)"' 2>/dev/null \
    || echo 2560x1600
}

# gen : fond « SOC Matrix » (dégradé, halo vert, grille, coins ambre), dessiné
# par wallgen à la résolution exacte de l'écran — le même que sous Windows.
gen() {
  need python3
  local size
  size=$(screen_size)
  "$(dirname "$(readlink -f "$0")")/wallgen" "$GEN" --size "$size" || die "wallgen a échoué (paquet python3-cairo ?)"
  ok "fond généré : $GEN ($size)"
}

# apply_file F : pointe current vers F et l'applique à toutes les sorties
apply_file() {
  ln -sfn "$1" "$CUR"
  if [[ -n ${SWAYSOCK:-} ]]; then
    swaymsg "output * bg $CUR fill #0b0f14" >/dev/null
  fi
  # invalide puis précalcule (arrière-plan) l'image de verrouillage
  rm -f "$BG_DIR"/lock-*.png
  if [[ -x $HOME/.local/bin/lock-glitch ]]; then
    ( "$HOME/.local/bin/lock-glitch" --preview "$BG_DIR/lock-$(basename "${1%.*}").png" >/dev/null 2>&1 & )
  fi
  info "fond : $1"
}

case ${1:-apply} in
  -h|--help) usage ;;
  gen) gen; apply_file "$GEN" ;;
  list) images ;;
  apply)
    if [[ ! -e $CUR ]]; then
      first=$(images | head -1)
      if [[ -z $first ]]; then gen; first=$GEN; fi
      apply_file "$first"
    else
      apply_file "$(readlink -f "$CUR")"
    fi ;;
  next)
    mapfile -t all < <(images)
    (( ${#all[@]} )) || { gen; all=("$GEN"); }
    cur=$(readlink -f "$CUR" 2>/dev/null || true); idx=0
    for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && idx=$(( (i + 1) % ${#all[@]} )); done
    apply_file "${all[$idx]}" ;;
  *) [[ -f $1 ]] || die "fichier introuvable : $1"; apply_file "$(readlink -f "$1")" ;;
esac
