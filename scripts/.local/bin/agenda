#!/usr/bin/env python3
# ╭──────────────────────────────────────────────────────────────────────╮
# │ agenda — agenda local « glass // SOC » (CLI)                          │
# │                                                                       │
# │ agenda                         aujourd'hui + 7 jours                  │
# │ agenda today|week|month|all    vues                                   │
# │ agenda add "Titre" <quand> [-t soc|data|cours|perso|admin]            │
# │        [-e FIN] [-r daily|weekdays|weekly|monthly] [-m MIN] [-n NOTE] │
# │     quand : « demain 14h », « lundi 9h30 », « 12/11 14:00 »,          │
# │             « dans 2h », « 16h », « 2026-11-12 14:00 »                │
# │ agenda done ID [JOUR]  ·  agenda rm ID  ·  agenda mv ID <quand>       │
# │ agenda next [--waybar] prochain événement                             │
# │ agenda menu            menu fuzzel (voir / ajouter / terminer)        │
# │ agenda gui             interface graphique                            │
# │ agenda remind          envoie les rappels dus (minuterie systemd)     │
# │ agenda export [F.ics]  ·  agenda import F.ics                         │
# │ agenda gsync [set-url|status]  Google Agenda → local (lecture seule)  │
# ╰──────────────────────────────────────────────────────────────────────╯
import argparse, json, os, subprocess, sys
from datetime import date, datetime, timedelta

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib', 'soc'))
import agenda_core as A

TTY = sys.stdout.isatty() and not os.environ.get('NO_COLOR')
def rgb(hexc, s): return f'\x1b[38;2;{int(hexc[1:3],16)};{int(hexc[3:5],16)};{int(hexc[5:7],16)}m{s}\x1b[0m' if TTY else s
ACC, MUT, FG, RED, GRN = '#7dd3c0', '#a8a8ae', '#e8e8ec', '#c07070', '#8fb090'
def dim(s): return rgb(MUT, s)
def die(msg): print(rgb(RED, '[✖] ') + msg, file=sys.stderr); sys.exit(1)


def show(d0, d1, title):
    occ = A.occurrences(d0, d1)
    print(rgb(ACC, f'╭─ {title} ') + dim(f'({len(occ)} événement{"s" if len(occ) != 1 else ""})'))
    if not occ: print(rgb(ACC, '╰─ ') + dim('rien de prévu')); return
    cur, now = None, datetime.now()
    for st, en, e, done in occ:
        if st.date() != cur:
            cur = st.date(); print(rgb(ACC, '│'))
            print(rgb(ACC, '├─ ') + rgb(FG, A.fr_day(cur)) + dim(f'  {cur:%d/%m}'))
        col, ico = A.TAGS.get(e.get('tag'), A.TAGS[A.DEFAULT_TAG])
        hours = 'journée    ' if e.get('allday') else f'{st:%H:%M}' + (f'–{en:%H:%M}' if en else '      ')
        mark = rgb(GRN, '✔') if done else (rgb(RED, '●') if st <= now <= (en or st + timedelta(minutes=30)) else rgb(col, '○'))
        rep = dim(' ↻') if e.get('repeat', 'none') != 'none' else ''
        ttl = dim(e['title']) if done else rgb(FG, e['title'])
        src = ' 󰊭' if e.get('source') == 'google' else ''
        print(rgb(ACC, '│  ') + f'{mark} {rgb(col, hours)}  {rgb(col, ico)} {ttl}{rep}  ' + dim(f'#{e["id"]} {e.get("tag","")}{src}'))
        if e.get('note'): print(rgb(ACC, '│  ') + dim('             ' + e['note'].split('\n')[0]))
    print(rgb(ACC, '╰─'))


def fuzzel(lines, prompt, extra=()):
    r = subprocess.run(['fuzzel', '--dmenu', '-p', prompt, *extra], input='\n'.join(lines), capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def notify(title, body, urgency='normal'):
    subprocess.run(['notify-send', '-a', 'agenda', '-u', urgency, '-i', 'x-office-calendar', title, body])


def menu():
    today = date.today()
    occ = [o for o in A.occurrences(today, today + timedelta(days=14)) if not o[3]]
    rows, keys = ['+  Nouvel événement', '󰃭  Ouvrir l\'agenda'], [None, None]
    for st, en, e, _ in occ:
        ico = A.TAGS.get(e.get('tag'), A.TAGS[A.DEFAULT_TAG])[1]
        rows.append(f'{ico}  {A.fr_day(st.date())[:12]:<12} {st:%H:%M}  {e["title"]}'); keys.append((e, st))
    sel = fuzzel(rows, 'agenda ❯ ', ['--lines', str(min(len(rows), 12)), '--width', '56'])
    if not sel: return
    i = rows.index(sel) if sel in rows else None
    if i == 1: os.execvp('agenda-gui', ['agenda-gui'])
    if i == 0 or i is None:
        title = sel if i is None else fuzzel([], 'titre ❯ ', ['--lines', '0'])
        if not title: return
        when = fuzzel(['dans 1h', 'aujourd\'hui 14h', 'demain 9h', 'demain 14h', 'lundi 9h'], 'quand ❯ ', ['--lines', '5'])
        if not when: return
        try: st = A.parse_when(when)
        except ValueError as x: notify('Agenda', str(x), 'critical'); return
        tag = fuzzel(list(A.TAGS), 'étiquette ❯ ', ['--lines', str(len(A.TAGS))]) or A.DEFAULT_TAG
        e = A.add(title, st, tag=tag)
        notify('Événement ajouté', f'{e["title"]}\n{A.fr_day(st.date())} à {st:%H:%M}')
        return
    e, st = keys[i]
    act = fuzzel(['✔  Terminé', '󰃰  Déplacer', '󰆴  Supprimer'], f'{e["title"][:24]} ❯ ', ['--lines', '3'])
    if not act: return
    if 'Terminé' in act: A.toggle_done(e['id'], st.date())
    elif 'Supprimer' in act: A.remove(e['id'])
    elif 'Déplacer' in act:
        when = fuzzel(['dans 1h', 'demain 9h', 'demain 14h'], 'nouveau moment ❯ ', ['--lines', '3'])
        if when:
            try: A.update(e['id'], start=A.parse_when(when).strftime(A.FMT), end=None)
            except ValueError as x: notify('Agenda', str(x), 'critical')


def gsync(a):
    """Google Agenda → local. Sans adresse configurée : sortie silencieuse (code 0) pour la minuterie."""
    import getpass, time
    import agenda_gsync as G
    stamp = os.path.join(A.DATA, 'gsync.json')
    sub = a[0] if a else 'run'
    if sub == 'set-url':
        url = a[1] if len(a) > 1 else getpass.getpass('Adresse secrète iCal (collée, non affichée) : ').strip()
        try: n = G.set_url(url)
        except ValueError as x: die(str(x))
        print(rgb(GRN, '[✔] ') + f'adresse enregistrée ({n} agenda(s)) dans {G.CONF} — lance : agenda gsync'); return
    if sub == 'status':
        n = len(G.urls()); g = [e for e in A.load() if e.get('source') == 'google']
        try: last = json.load(open(stamp))
        except (OSError, ValueError): last = None
        print(rgb(ACC, '╭─ Synchronisation Google Agenda'))
        print(rgb(ACC, '│ ') + f'agendas configurés : {n}' + ('' if n else dim('   → agenda gsync set-url')))
        print(rgb(ACC, '│ ') + f'événements Google en local : {len(g)}')
        print(rgb(ACC, '│ ') + 'dernière synchro : ' + (f"{last['when']} ({last['result']})" if last else 'jamais'))
        print(rgb(ACC, '╰─')); return
    if sub != 'run': die('usage : agenda gsync [set-url [ADRESSE] | status]')
    os.makedirs(A.DATA, exist_ok=True)
    def mark(res): json.dump({'when': time.strftime('%Y-%m-%d %H:%M'), 'result': res}, open(stamp, 'w'), ensure_ascii=False)
    try: n, k = G.sync()
    except LookupError:
        print('agenda gsync : aucune adresse configurée (agenda gsync set-url) — rien à faire'); return
    except ConnectionError as x:
        mark(f'échec : {x}'); die(f'synchronisation Google impossible : {x}')
    mark(f'{n} événements, {k} agenda(s)')
    print(rgb(GRN, '[✔] ') + f'{n} événements Google synchronisés ({k} agenda(s), {G.PAST} j passés → {G.FUTURE} j à venir)')


def main():
    p = argparse.ArgumentParser(prog='agenda', add_help=False)
    p.add_argument('cmd', nargs='?', default='upcoming'); p.add_argument('args', nargs='*')
    p.add_argument('-t', '--tag', default=A.DEFAULT_TAG); p.add_argument('-e', '--end')
    p.add_argument('-r', '--repeat', default='none', choices=A.REPEATS); p.add_argument('-m', '--remind', type=int, default=15)
    p.add_argument('-n', '--note', default=''); p.add_argument('--waybar', action='store_true'); p.add_argument('-h', '--help', action='store_true')
    o = p.parse_args(); a, today = o.args, date.today()
    if o.help or o.cmd == 'help':
        for l in open(os.path.realpath(__file__)).read().split('\n')[2:18]: print(l.strip('# │').rstrip('│ ').rstrip())
        return
    c = o.cmd
    if c == 'upcoming': show(today, today + timedelta(days=7), 'Agenda · 7 prochains jours')
    elif c == 'today': show(today, today, 'Agenda · aujourd\'hui')
    elif c == 'week': show(today - timedelta(days=today.weekday()), today + timedelta(days=6 - today.weekday()), 'Agenda · cette semaine')
    elif c == 'month': show(today.replace(day=1), (today.replace(day=28) + timedelta(days=4)).replace(day=1) - timedelta(days=1), f'Agenda · {A.MOIS[today.month-1]}')
    elif c == 'all': show(today - timedelta(days=365), today + timedelta(days=365), 'Agenda · tout')
    elif c == 'add':
        if len(a) < 2: die('usage : agenda add "Titre" <quand>   (ex. agenda add "Revue alertes" demain 9h -t soc)')
        if o.tag not in A.TAGS: die(f'étiquette inconnue : {o.tag} (choix : {", ".join(A.TAGS)})')
        try:
            st = A.parse_when(' '.join(a[1:])); en = None
            if o.end:
                t = A._time(o.end.lower().strip())
                en = st.replace(hour=t[0], minute=t[1]) if t else A.parse_when(o.end)
                if en <= st: die('la fin doit être après le début')
        except ValueError as x: die(str(x))
        e = A.add(a[0], st, en, o.tag, o.repeat, o.remind, o.note)
        print(rgb(GRN, '[✔] ') + f'#{e["id"]} {e["title"]} — {A.fr_day(st.date())} à {st:%H:%M}' + (f' ({A.REPEAT_FR[o.repeat]})' if o.repeat != 'none' else ''))
    elif c in ('done', 'rm', 'mv'):
        if not a or not a[0].isdigit(): die(f'usage : agenda {c} ID')
        eid = int(a[0])
        if c == 'rm': print(rgb(GRN, '[✔] supprimé') if A.remove(eid) else rgb(RED, '[✖] ID inconnu'))
        elif c == 'done':
            d = A.parse_when(' '.join(a[1:])).date() if len(a) > 1 else today
            r = A.toggle_done(eid, d)
            print(rgb(RED, '[✖] ID inconnu') if r is None else rgb(GRN, '[✔] ') + ('terminé' if r else 'rouvert') + f' ({d:%d/%m})')
        else:
            try: st = A.parse_when(' '.join(a[1:]))
            except ValueError as x: die(str(x))
            print(rgb(GRN, f'[✔] déplacé au {st:%d/%m %H:%M}') if A.update(eid, start=st.strftime(A.FMT), end=None) else rgb(RED, '[✖] ID inconnu'))
    elif c == 'next':
        n = A.next_occurrence()
        if o.waybar:
            if not n: print(json.dumps({'text': '󰃭 libre', 'class': 'free', 'tooltip': 'Aucun événement à venir'}, ensure_ascii=False)); return
            st, en, e, _ = n; now = datetime.now(); mins = (st - now).total_seconds() / 60
            cls = 'now' if mins <= 0 else 'soon' if mins <= 15 else 'today' if st.date() == today else 'later'
            day = '' if st.date() == today else A.fr_day(st.date())[:3].lower() + ' '
            tip = '\n'.join(f'{A.JOURS[s.weekday()][:3]} {s:%d/%m %H:%M}  {x["title"]}' for s, _, x, d in A.occurrences(today, today + timedelta(days=3)) if not d) or 'rien'
            print(json.dumps({'text': f'{A.TAGS.get(e.get("tag"), A.TAGS[A.DEFAULT_TAG])[1]} {day}{st:%H:%M} {e["title"][:22]}', 'class': [cls, e.get('tag', '')], 'tooltip': tip}, ensure_ascii=False))
        elif n: print(f'{n[0]:%d/%m %H:%M}  {n[2]["title"]}  ({A.countdown(n[0])})')
        else: print('aucun événement à venir')
    elif c == 'remind':
        for st, e in A.due_reminders():
            notify(f'{A.TAGS.get(e.get("tag"), A.TAGS[A.DEFAULT_TAG])[1]}  {e["title"]}', f'{st:%H:%M} — {A.countdown(st)}' + (f'\n{e["note"]}' if e.get('note') else ''),
                   'critical' if e.get('tag') == 'soc' else 'normal')
    elif c == 'gsync': gsync(a)
    elif c == 'menu': menu()
    elif c == 'gui': os.execvp('agenda-gui', ['agenda-gui'])
    elif c == 'export':
        ics = A.to_ics()
        if a: open(a[0], 'w').write(ics); print(rgb(GRN, '[✔] ') + f'{len(A.load())} événements → {a[0]}')
        else: sys.stdout.write(ics)
    elif c == 'import':
        if not a or not os.path.exists(a[0]): die('usage : agenda import fichier.ics')
        print(rgb(GRN, '[✔] ') + f'{A.from_ics(open(a[0]).read())} événements importés')
    else: die(f'commande inconnue : {c} (agenda --help)')


if __name__ == '__main__':
    main()
