#!/usr/bin/env bash
# ╭──────────────────────────────────────────────────────────────────────╮
# │ ws-switch — espace de travail suivant / précédent (1 ↔ 10)           │
# │ Usage : ws-switch next|prev [--move]                                 │
# │   --move  emmène la fenêtre focalisée                                │
# │ Contrairement à `workspace next_on_output`, va aussi vers les espaces│
# │ vides (comportement attendu du glisser à 4 doigts).                  │
# ╰──────────────────────────────────────────────────────────────────────╯
set -euo pipefail
usage() { sed -n '3,7p' "$0" | sed 's/^# │ \{0,1\}//; s/ *│$//'; }
command -v jq >/dev/null || { echo "jq requis" >&2; exit 127; }
case ${1:-} in next|prev) ;; -h|--help) usage; exit 0 ;; *) usage >&2; exit 1 ;; esac

cur=$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | .num')
(( cur >= 1 )) || cur=1
if [[ $1 == next ]]; then n=$(( cur % 10 + 1 )); else n=$(( (cur + 8) % 10 + 1 )); fi
if [[ ${2:-} == --move ]]; then
  swaymsg "move container to workspace number $n, workspace number $n" >/dev/null
else
  swaymsg "workspace number $n" >/dev/null
fi
