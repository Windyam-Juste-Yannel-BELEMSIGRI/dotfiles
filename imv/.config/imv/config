# imv — palette glass // SOC
[options]
background = 0b0f14
overlay = false
overlay_font = JetBrains Mono:11
overlay_text_color = c5d1de
overlay_background_color = 121821
overlay_background_alpha = dd
title_text = imv — $imv_current_file ($imv_current_index/$imv_file_count)
overlay_text = $imv_current_file  ·  ${imv_width}×${imv_height}  ·  ${imv_scale}%

[binds]
i = overlay
<Delete> = exec rm "$imv_current_file"; close
