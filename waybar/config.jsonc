{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "margin-bottom": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": [
        "mpris",
        "idle_inhibitor",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "battery",
        "tray",
        "custom/lock",
        "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "default": "○",
            "focused": "●",
            "urgent": "!"
        }
    },

    "sway/mode": {
        "format": "  {}"
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muet",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "⚠ Déconnecté",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-off": " off",
        "on-click": "blueman-manager"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/lock": {
        "format": "",
        "tooltip-format": "Verrouiller",
        "on-click": "swaylock -f -c 2e2e2ecc"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Alimentation",
        "on-click": "wlogout --margin-top 400 --margin-bottom 400 --margin-left 700 --margin-right 700"
    },
    
    "mpris": {
	"format": "{player_icon} {title} - {artist}",
	"format-paused": "{status_icon} {title} - {artist}",
	"player-icons": {
	    "default": "▶",
	    "spotify": "🎵"
	},
	"status-icons": {
	     "paused": "⏸"
	},
	"max-length": 40
    }
}
