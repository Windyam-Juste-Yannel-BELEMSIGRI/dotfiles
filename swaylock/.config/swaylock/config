inside-wrong-color=2a0f16cc
ring-color=00ff9c
ring-clear-color=00e5ff
ring-ver-color=4fc3f7
ring-wrong-color=ff5370
key-hl-color=c5d1de
bs-hl-color=ff5370
caps-lock-key-hl-color=ffb000
caps-lock-bs-hl-color=ff5370
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color=c5d1de
text-clear-color=00e5ff
text-ver-color=4fc3f7
text-wrong-color=ff5370
text-caps-lock-color=ffb000
layout-bg-color=00000000
layout-text-color=7d8898
