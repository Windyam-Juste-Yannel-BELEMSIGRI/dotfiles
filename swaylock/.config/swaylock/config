# ── swaylock 1.8 (Debian, SANS swaylock-effects) ─────────────────────────
# Les effets (flou/glitch) sont précalculés par ~/.local/bin/lock-glitch
# qui passe l'image via -i. Ici : couleurs de l'indicateur (thème d'origine
# lock.sh : anneau sarcelle #7dd3c0).
ignore-empty-password
show-failed-attempts
indicator-caps-lock
font=JetBrainsMono Nerd Font
indicator-radius=100
indicator-thickness=8
color=1c1c1e
inside-color=1c1c1ecc
inside-clear-color=1c1c1ecc
inside-ver-color=2a2a2ecc
inside-wrong-color=2a1c1ecc
ring-color=7dd3c0
ring-clear-color=8de3d0
ring-ver-color=7a9dc0
ring-wrong-color=c07070
key-hl-color=e8e8ec
bs-hl-color=c07070
caps-lock-key-hl-color=d8a657
caps-lock-bs-hl-color=c07070
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color=e8e8ec
text-clear-color=8de3d0
text-ver-color=7a9dc0
text-wrong-color=c07070
text-caps-lock-color=d8a657
layout-bg-color=00000000
layout-text-color=a8a8ae
