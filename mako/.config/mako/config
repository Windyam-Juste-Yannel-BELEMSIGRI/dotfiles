# ── mako "glass // SOC" (mako 1.10) ──────────────────────────────────────
# Mode "ne pas déranger" : makoctl mode -t do-not-disturb (Super+Shift+M)
font=JetBrainsMono Nerd Font 10
background-color=#0b0f14e6
text-color=#c5d1de
border-color=#00ff9c55
progress-color=over #00ff9c66
border-radius=10
border-size=1
padding=12
margin=10
outer-margin=6
width=360
height=140
default-timeout=5000
max-visible=5
max-history=50
icons=1
max-icon-size=32
icon-path=/usr/share/icons/Papirus-Dark
anchor=top-right
layer=overlay
format=<b>%s</b>\n%b
group-by=app-name

[urgency=low]
border-color=#4a5a6a
default-timeout=3000

[urgency=critical]
border-color=#ff5370
background-color=#2a0f16e6
default-timeout=0

# OSD (volume, luminosité…) : notification remplacée en place, centrée en bas
[app-name=osd]
anchor=bottom-center
width=280
height=60
default-timeout=1200
group-by=none
border-color=#00ff9c
format=%s

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
