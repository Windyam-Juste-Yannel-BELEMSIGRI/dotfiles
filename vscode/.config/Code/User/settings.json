{
  // Couleurs « SOC Matrix » (mêmes surcharges que windows-geek-theme, sans extension tierce)
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "focusBorder": "#00ff9c",
    "editor.background": "#0b0f14",
    "sideBar.background": "#080b0f",
    "activityBar.background": "#080b0f",
    "activityBar.foreground": "#00ff9c",
    "activityBarBadge.background": "#00ff9c",
    "activityBarBadge.foreground": "#0b0f14",
    "titleBar.activeBackground": "#080b0f",
    "statusBar.background": "#080b0f",
    "statusBar.foreground": "#00ff9c",
    "statusBar.border": "#00ff9c33",
    "statusBarItem.remoteBackground": "#00ff9c",
    "statusBarItem.remoteForeground": "#0b0f14",
    "panel.background": "#0b0f14",
    "terminal.background": "#0b0f14",
    "terminal.ansiGreen": "#00ff9c",
    "terminal.ansiCyan": "#00e5ff",
    "terminal.ansiYellow": "#ffb000",
    "terminal.ansiRed": "#ff5370",
    "terminal.ansiMagenta": "#b388ff",
    "tab.activeBorderTop": "#00ff9c",
    "editorCursor.foreground": "#00ff9c",
    "list.activeSelectionBackground": "#12332b"
  },
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  "workbench.startupEditor": "none",

  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.rulers": [88],
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Vie privée / mises à jour (code est mis à jour par apt)
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "git.autofetch": false,

  // Python : ruff au formatage, venv du projet (.venv créé par uv)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },
  "python.terminal.activateEnvironment": true,

  // LaTeX : latexmk, PDF dans un onglet, fichiers auxiliaires dans build/
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoClean.run": "onFailed",

  // C
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.compilerPath": "/usr/bin/gcc",
  "workbench.editor.autoLockGroups": {
    "terminalEditor": false
  }
}
