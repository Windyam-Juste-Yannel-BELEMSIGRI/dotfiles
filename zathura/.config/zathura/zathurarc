# zathura — palette glass // SOC (miroir de foot / waybar)
# Ctrl+R : inverser les couleurs du document (lecture de nuit)
set font                    "JetBrains Mono 11"
set default-bg              "#0b0f14"
set default-fg              "#c5d1de"
set statusbar-bg            "#121821"
set statusbar-fg            "#7d8898"
set inputbar-bg             "#0b0f14"
set inputbar-fg             "#00ff9c"
set notification-bg         "#121821"
set notification-fg         "#c5d1de"
set notification-error-bg   "#ff5370"
set notification-error-fg   "#0b0f14"
set notification-warning-bg "#ffb000"
set notification-warning-fg "#0b0f14"
set completion-bg           "#121821"
set completion-fg           "#c5d1de"
set completion-group-bg     "#0b0f14"
set completion-group-fg     "#00ff9c"
set completion-highlight-bg "#00ff9c"
set completion-highlight-fg "#0b0f14"
set index-bg                "#0b0f14"
set index-fg                "#c5d1de"
set index-active-bg         "#00ff9c"
set index-active-fg         "#0b0f14"
set highlight-color         "rgba(0,255,156,0.35)"
set highlight-active-color  "rgba(0,229,255,0.60)"
set recolor-lightcolor      "#0b0f14"
set recolor-darkcolor       "#c5d1de"
set recolor-keephue         true

set selection-clipboard     clipboard
set adjust-open             "best-fit"
set scroll-page-aware       true
set statusbar-home-tilde    true
set window-title-basename   true
# LaTeX : Ctrl+clic dans le PDF → ligne source dans VS Code
set synctex                 true
set synctex-editor-command  "code --goto %{input}:%{line}"
