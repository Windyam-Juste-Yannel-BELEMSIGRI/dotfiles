# ╭──────────────────────────────────────────────────────────────────────╮
# │  ~/.config/sway/config — "glass // SOC" (Sway 1.10, Debian 13)       │
# │  Même identité que le portfolio et windows-geek-theme (SOC Matrix).  │
# │  Les blocs thématiques sont dans config.d/*.conf (ordre alphabétique) │
# │  Secours : sway -c ~/.config/sway/config.fallback                     │
# ╰──────────────────────────────────────────────────────────────────────╯

### Variables ---------------------------------------------------------------
set $mod   Mod4
set $left  h
set $down  j
set $up    k
set $right l
set $term  foot
set $menu  fuzzel
set $bin   ~/.local/bin

### Palette « SOC Matrix » (celle du portfolio et de windows-geek-theme ;
### identique dans waybar, foot, fuzzel, mako, GTK…) -------------------------
set $bg        #0b0f14
set $surface   #121821
set $overlay   #1e2632
set $fg        #c5d1de
set $muted     #7d8898
set $dim       #5c6b7a
set $accent    #00ff9c
set $accent2   #00e5ff
set $edge      #1b3a33
set $red       #ff5370
set $yellow    #ffb000

# Intégration systemd (DISPLAY, WAYLAND_DISPLAY, SWAYSOCK → services user)
include /etc/sway/config.d/*

# Modules de configuration
include ~/.config/sway/config.d/*.conf

# Surcharges locales non versionnées (ex. échelle d'écran) : local.d/*.conf
include ~/.config/sway/local.d/*.conf
